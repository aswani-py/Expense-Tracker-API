#API call for user register
###
POST http://127.0.0.1:8000/user
Content-Type: application/json

{
    "username":"akil",
    "email":"akil@gmail.com",
    "password":"akil@123"
}


#API call for create expense

###
POST http://127.0.0.1:8000/expense
Authorization: Basic akil:akil@123
Content-Type: application/json

{
    "title":"Petrol",
    "amount":"1000",
    "category":"fuel",
    "payment":"UPI"
}

#API call for list   expense
###
GET http://127.0.0.1:8000/expense
Authorization: Basic ammu:ammu@123


#API call for expense detail view
###
GET http://127.0.0.1:8000/expense/detail/7
Authorization: Basic ammu:ammu@123

#API call for update expense data
###
PUT http://127.0.0.1:8000/expense/detail/9/
Authorization: Basic abc:abc@123
Content-Type: application/json

{
 "id": 9,
  "owner": {
    "username": "amal",
    "email": "amal@gmail.com",
