#API call for delete expense data
###
DELETE http://127.0.0.1:8000/expense/detail/2/
Authorization: Basic abcd:abcd@123

#API call for filtering based on category
###
GET http://127.0.0.1:8000/expense?category=food
Authorization: Basic abcd:abcd@123

#API call for filtering based on payment method
###
GET http://127.0.0.1:8000/expense?payment=card
Authorization: Basic abc:abc@123

#API call for searching based on title
###
GET http://127.0.0.1:8000/expense?title=petrol
Authorization: Basic amal:amal@123

#API call for ordering  based on amount
###
GET http://127.0.0.1:8000/expense?ordering=amount
Authorization: Basic akil:akil@123


#API call for ordering based on created date
###
GET http://127.0.0.1:8000/expense?ordering=created_at
Authorization: Basic amal:amal@123
